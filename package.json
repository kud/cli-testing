{
  "name": "@kud/cli-testing",
  "version": "0.1.0",
  "type": "module",
  "description": "Test helpers for Ink CLIs — frame-history rendering and isolated subprocess runs",
  "license": "MIT",
  "homepage": "https://kud.io/projects/cli-testing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kud/cli-testing.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "ink": ">=7",
    "ink-testing-library": ">=4",
    "react": ">=19"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "ink": "7.1.1",
    "ink-testing-library": "4.0.0",
    "react": "19.2.8",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
